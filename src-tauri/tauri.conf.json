{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Post",
  "version": "0.1.0",
  "identifier": "app.nostr.post",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Post — Private messaging for Nostr",
        "width": 1440,
        "height": 1024,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss://*.nostr.* wss://relay.*; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://releases.nostr.app/{{target}}/{{arch}}/{{current_version}}"
      ]
    },
    "stronghold": {}
  }
}
